{
  "name": "github-contributions-shade",
  "version": "1.1.0",
  "private": true,
  "description": "Chrome extension that re-buckets the GitHub contribution calendar shades using per-profile thresholds",
  "type": "module",
  "scripts": {
    "build": "webpack && cp dist/*.min.js github-contributions-shade/ && rm -r dist",
    "clean": "rm -f github-contributions-shade/*.min.js && rm -f github-contributions-shade.zip",
    "package": "pnpm run clean && pnpm run build && zip -r github-contributions-shade.zip github-contributions-shade",
    "eslint": "eslint .",
    "tsc": "tsc --noEmit",
    "wdio": "wdio run ./wdio.conf.ts && test -s .coverage/clover.xml",
    "test": "pnpm run build && pnpm run eslint && pnpm run tsc && pnpm run wdio"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/albertyw/github-contributions-shade.git"
  },
  "author": "Albert Wang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/albertyw/github-contributions-shade/issues"
  },
  "homepage": "https://github.com/albertyw/github-contributions-shade#readme",
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@wdio/browser-runner": "^10.0.0",
    "@wdio/cli": "^10.0.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/types": "^9.32.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
