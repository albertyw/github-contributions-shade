{
  "manifest_version": 3,
  "name": "GitHub Contributions Shade",
  "version": "1.0.0",

  "description": "Re-shade the GitHub contribution calendar using your own per-profile thresholds so one outlier day cannot flatten the year.",

  "author": "Albert Wang",
  "homepage_url": "https://github.com/albertyw/github-contributions-shade",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["github-contributions-shade.min.js"],
    "run_at": "document_idle"
  }],

  "permissions": ["storage"],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
